Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Updates appear automatically + faster loading ----------------------------
# Pages, scripts and styles are re-checked with the server on every visit. When nothing
# changed the server answers with a tiny "304 not modified"; when you upload a new version
# it is downloaded straight away - no refreshing or clearing browsing data needed.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Images, fonts and video rarely change: keep them for a week so repeat visits load instantly.
    # (If you replace an image, give the new file a new name or add ?v=2 to its link.)
    <FilesMatch "\.(png|jpg|jpeg|webp|gif|svg|ico|woff|woff2|mp4|webm)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Compress text so pages, scripts and styles download much faster.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

<Files "*.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# ---- SEO: keep private/utility pages out of Google ------------------------------------------
# Login, admin, staff and installer pages must never show up in search results.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "/frontend/html/(admin|staff|auth|company)/" NOINDEX_PAGE
    SetEnvIf Request_URI "/frontend/html/(install|notifications)\.html$" NOINDEX_PAGE
    SetEnvIf Request_URI "/install\.php$" NOINDEX_PAGE
</IfModule>
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_PAGE
</IfModule>

# ---- Security: never serve the git history or server backup folders ------------------------
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
    RedirectMatch 404 ^/backup-
</IfModule>

# ---- OPTIONAL: force HTTPS + www (one address per page = stronger SEO) ----------------------
# Only remove the leading "#" on these lines AFTER you have checked that BOTH
# https://www.mabumbatech.co.tz and https://mabumbatech.co.tz open correctly in a browser.
# If either does not open, enabling this would take the site offline.
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on [OR]
#     RewriteCond %{HTTP_HOST} !^www\. [NC]
#     RewriteRule ^(.*)$ https://www.mabumbatech.co.tz/$1 [L,R=301]
# </IfModule>
